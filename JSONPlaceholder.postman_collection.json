    },
    {
      "name": "Users - Schema Validation (Bonus)",
      "item": [
        {
          "name": "GET All Users (Positive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time is below 1000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "pm.test('Returns exactly 10 users', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.eql(10);",
                  "});",
                  "",
                  "pm.test('Each user has a valid email format', function () {",
                  "    const jsonData = pm.response.json();",
                  "    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;",
                  "    jsonData.forEach(user => {",
                  "        pm.expect(user.email).to.match(emailRegex);",
                  "    });",
                  "});",
                  "",
                  "pm.test('Each user has nested address and company objects', function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.forEach(user => {",
                  "        pm.expect(user).to.have.property('address');",
                  "        pm.expect(user).to.have.property('company');",
                  "        pm.expect(user.address).to.have.property('geo');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ]
